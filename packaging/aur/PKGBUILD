# Maintainer: Jonathan St-Michel <jstmichel at kodara dot me>

pkgname=kobold
pkgver=0.1.0
pkgrel=1
pkgdesc='Sync Komga books and local shelves with Kobo e-readers (KDE app and CLI)'
arch=('x86_64')
url='https://github.com/jstmichel/kobold'
license=('MIT')
depends=(
  'kconfig'
  'kcoreaddons'
  'kcrash'
  'kepubify'
  'karchive'
  'ki18n'
  'kiconthemes'
  'kirigami'
  'kirigami-addons'
  'poppler-qt6'
  'qt6-base'
  'qt6-declarative'
  'qtkeychain-qt6'
  'solid'
)
makedepends=(
  'cmake'
  'extra-cmake-modules'
  'gettext'
  'ninja'
)
# The shell tests of check() script a fake Kobo database and a local web server.
checkdepends=(
  'python'
  'sqlite'
)
optdepends=(
  'kwallet: store the Komga API key on Plasma'
  'kcc: convert CBZ and CBR comics (AUR)'
  '7zip: archive extraction for kcc'
  'python-cffi: needed by a kcc dependency'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/jstmichel/kobold/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('9b7854d1f680969497f9f00d664ec3025b1e8e95c37b39bc3b6ae1fbc78e3d1a')

build() {
  cmake -B build -S "$pkgname-$pkgver" -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_TESTING=ON
  cmake --build build
}

check() {
  QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
