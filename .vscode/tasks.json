{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build (dev)",
      "type": "shell",
      "command": "cmake --preset dev && cmake --build --preset dev",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "test (dev)",
      "type": "shell",
      "command": "ctest --preset dev",
      "group": { "kind": "test", "isDefault": true },
      "dependsOn": "build (dev)"
    }
  ]
}
