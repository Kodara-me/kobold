#: src/cli/main.cpp:80
#, kde-format
msgid ""
"Commands:\n"
"  config set-url <url>   Set the Komga server URL\n"
"  config set-api-key     Read the Komga API key from standard input and "
"store it\n"
"  config show            Show the configuration (never the API key)\n"
"  config set-profile <p> Set the KCC comic profile of the connected Kobo (--"
"clear removes it)\n"
"  device                 Show the connected Kobo (name, model, profile, "
"selection)\n"
"  device list            List the known Kobos\n"
"  device rename <name>   Rename a Kobo (--kobo to choose which)\n"
"  device mount           Mount a Kobo that is plugged in but not mounted\n"
"  device eject           Eject the Kobo so that it indexes its books (--all "
"for every one)\n"
"  device books           List every book of the Kobo (--hidden, --visible, --"
"origin, --search)\n"
"  device hide <id>... | show <id>...\n"
"                         Hide books from the Kobo's library, or show them "
"again\n"
"  device mark-read <id>... | mark-unread <id>...\n"
"                         Change the read status of books on the Kobo\n"
"  device delete <id>...  Delete Komga books and files from the Kobo "
"(undoable; not store books)\n"
"  device history | undo [<batch>]\n"
"                         List or undo the changes made to the Kobo's books\n"
"  device backups | restore <backup>\n"
"                         List or restore the backups of the Kobo's database\n"
"  select search <text>   Search Komga for books\n"
"  select add <id>...     Add books to the selection\n"
"  select add --series <s> [--volumes <range>] | --collection <c> | --"
"readlist <r>\n"
"                         Follow a series, collection or read list\n"
"  select remove <id>...  Remove books from the selection\n"
"  select add-file <path>...  Add files from the computer (EPUB, PDF, CBZ, "
"CBR)\n"
"  select remove-file <path>...\n"
"                         Take files from the computer out of the selection\n"
"  select list            List the selected books\n"
"  library libraries      List the Komga libraries\n"
"  library series [<series>]            List series, or the books of one\n"
"  library collections | collection <c> List collections, or the books of "
"one\n"
"  library readlists | readlist <r>     List read lists, or the books of one\n"
"  sync                   Copy the selected books to the Kobo and remove "
"deselected ones\n"
"  pull-progress          Send reading progress from the Kobo to Komga\n"
"  status                 Show the configuration, the Kobo and the pending "
"changes\n"
"  doctor                 Check dependencies and configuration\n"
"  kobo-sync status       Show the Komga sync endpoint of a Kobo\n"
"  kobo-sync install      Point the Kobo to Komga's own Kobo sync (creates "
"its key)\n"
"  kobo-sync uninstall    Point the Kobo back to the Kobo Store\n"
"  kobo-sync reinstall    Write the endpoint again, after a firmware update\n"
"  kobo-sync set-key      Change the Kobo's Komga key (standard input, or --"
"create)\n"
"  kobo-sync reset        Make the Kobo download every book again from Komga\n"
"  parental status        Show parental control (enable, disable, set-age, "
"add-keyword, remove-keyword)\n"
"  shelf add <name> <folder>  Add a shelf: a folder of books outside Komga, "
"scanned by Kobold\n"
"  shelf scan [<shelf>]   Scan shelves for new, changed and missing books\n"
"  shelf list | series [<shelf>] | books <series> | show <book or series>\n"
"                         Browse shelves (also: remove, rename)\n"
"  shelf edit <book or series>... --set <field>=<value> --unset <field>\n"
"                         Edit metadata; several books share series, authors, "
"genres, age...\n"
"  shelf lookup <book or series>  Find metadata online (Open Library, Google "
"Books, ComicVine)\n"
"  shelf export <file> | import <file>  Move the edits to another computer\n"
"  shelf create-library [<folder>]  Create a Kobold Library folder (in "
"Documents) as a shelf\n"
"  shelf set-comicvine-key  Read the ComicVine API key from standard input "
"and store it"
msgstr ""
"Commandes :\n"
"  config set-url <url>   Définir l'URL du serveur Komga\n"
"  config set-api-key     Lire la clé d'API Komga sur l'entrée standard et "
"l'enregistrer\n"
"  config show            Afficher la configuration (jamais la clé d'API)\n"
"  config set-profile <p> Définir le profil BD KCC du Kobo connecté (--clear "
"le retire)\n"
"  device                 Afficher le Kobo connecté (nom, modèle, profil, "
"sélection)\n"
"  device list            Lister les Kobo connus\n"
"  device rename <nom>    Renommer un Kobo (--kobo pour choisir lequel)\n"
"  device mount           Monter un Kobo branché mais non monté\n"
"  device eject           Éjecter le Kobo pour qu'il indexe ses livres (--all "
"pour tous)\n"
"  device books           Lister tous les livres du Kobo (--hidden, --"
"visible, --origin, --search)\n"
"  device hide <id>... | show <id>...\n"
"                         Masquer des livres de la bibliothèque du Kobo, ou "
"les réafficher\n"
"  device mark-read <id>... | mark-unread <id>...\n"
"                         Changer l'état de lecture de livres du Kobo\n"
"  device delete <id>...  Supprimer du Kobo des livres Komga et des fichiers "
"(annulable ; pas les livres de la boutique)\n"
"  device history | undo [<lot>]\n"
"                         Lister ou annuler les changements faits aux livres "
"du Kobo\n"
"  device backups | restore <sauvegarde>\n"
"                         Lister ou restaurer les sauvegardes de la base du "
"Kobo\n"
"  select search <texte>  Chercher des livres dans Komga\n"
"  select add <id>...     Ajouter des livres à la sélection\n"
"  select add --series <s> [--volumes <plage>] | --collection <c> | --"
"readlist <l>\n"
"                         Suivre une série, une collection ou une liste de "
"lecture\n"
"  select remove <id>...  Retirer des livres de la sélection\n"
"  select add-file <chemin>...  Ajouter des fichiers de l'ordinateur (EPUB, "
"PDF, CBZ, CBR)\n"
"  select remove-file <chemin>...\n"
"                         Retirer de la sélection des fichiers de "
"l'ordinateur\n"
"  select list            Lister les livres sélectionnés\n"
"  library libraries      Lister les bibliothèques Komga\n"
"  library series [<série>]             Lister les séries, ou les livres de "
"l'une d'elles\n"
"  library collections | collection <c> Lister les collections, ou les livres "
"de l'une d'elles\n"
"  library readlists | readlist <l>     Lister les listes de lecture, ou les "
"livres de l'une d'elles\n"
"  sync                   Copier les livres sélectionnés sur le Kobo et "
"retirer les autres\n"
"  pull-progress          Envoyer la progression de lecture du Kobo à Komga\n"
"  status                 Afficher la configuration, le Kobo et les "
"changements en attente\n"
"  doctor                 Vérifier les dépendances et la configuration\n"
"  kobo-sync status       Afficher le point d'accès de synchronisation Komga "
"d'un Kobo\n"
"  kobo-sync install      Faire pointer le Kobo vers la synchronisation Kobo "
"de Komga (crée sa clé)\n"
"  kobo-sync uninstall    Faire pointer de nouveau le Kobo vers la boutique "
"Kobo\n"
"  kobo-sync reinstall    Réécrire le point d'accès, après une mise à jour du "
"micrologiciel\n"
"  kobo-sync set-key      Changer la clé Komga du Kobo (entrée standard, ou --"
"create)\n"
"  kobo-sync reset        Faire retélécharger tous les livres de Komga au "
"Kobo\n"
"  parental status        Afficher le contrôle parental (enable, disable, set-"
"age, add-keyword, remove-keyword)\n"
"  shelf add <nom> <dossier>  Ajouter une étagère : un dossier de livres hors "
"de Komga, scanné par Kobold\n"
"  shelf scan [<étagère>] Scanner les étagères (livres nouveaux, modifiés, "
"absents)\n"
"  shelf list | series [<étagère>] | books <série> | show <livre ou série>\n"
"                         Parcourir les étagères (aussi : remove, rename)\n"
"  shelf edit <livre ou série>... --set <champ>=<valeur> --unset <champ>\n"
"                         Modifier les métadonnées ; plusieurs livres "
"partagent série, auteurs, genres, âge...\n"
"  shelf lookup <livre ou série>  Chercher les métadonnées en ligne (Open "
"Library, Google Books, ComicVine)\n"
"  shelf export <fichier> | import <fichier>  Déplacer les modifications vers "
"un autre ordinateur\n"
"  shelf create-library [<dossier>]  Créer un dossier Bibliothèque Kobold "
"(dans Documents) comme étagère\n"
"  shelf set-comicvine-key  Lire la clé d'API ComicVine sur l'entrée standard "
"et l'enregistrer"

